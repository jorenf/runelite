# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ---- Server ----
PORT=3000

# ---- VAPID keys (Web Push) ----
# Generate once with:
#   node -e "const wp=require('web-push'); console.log(JSON.stringify(wp.generateVAPIDKeys(),null,2))"
# Then paste the output below.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact email shown in the VAPID header (required by push services)
VAPID_SUBJECT=mailto:your-email@example.com

# ---- State persistence ----
# Path to a JSON file where subscriptions and patch state are stored.
# Defaults to ./data/state.json when left blank.
STATE_FILE=
